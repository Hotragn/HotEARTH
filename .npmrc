# @vercel/analytics declares every framework peer as OPTIONAL, including
# react ^18 || ^19, so nothing here is actually incompatible. npm's resolver
# still tries to satisfy the optional @remix-run/react peer, finds that Remix 2
# wants react ^18, and fails against this project's react 19.
#
# Remove this the day that package stops declaring peers npm cannot skip.
# `npm ci` reads the lockfile and does not re-resolve, so CI never needed it;
# this is here so a plain `npm install` works for the next person too.
legacy-peer-deps=true
